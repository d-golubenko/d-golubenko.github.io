{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dgolubenko",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {"enabled": true, "invocation_logs": false},
    "redact_query_string": true
  }
}
